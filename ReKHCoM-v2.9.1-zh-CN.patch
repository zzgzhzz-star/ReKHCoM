diff --git a/port/tools/package_zh_launcher.py b/port/tools/package_zh_launcher.py
new file mode 100644
index 0000000..f40aed5
--- /dev/null
+++ b/port/tools/package_zh_launcher.py
@@ -0,0 +1,59 @@
+"""Replace only the launcher and add its font to a verified upstream package."""
+import argparse
+import hashlib
+from pathlib import Path
+import re
+from zipfile import ZipFile, ZIP_DEFLATED
+
+
+UPSTREAM_SHA256 = {
+    "windows": "441d3f08dc4834d034981e48395aace0584ae0fdcd192d9c387b4a4cdc4259d9",
+    "android": "552a3cf19d4aedda9992ecb30efc4b2cd609a695b61696a3a8822924e9aca46a",
+}
+APK_SIGNATURE = re.compile(r"META-INF/(?:MANIFEST\.MF|[^/]+\.(?:SF|RSA|DSA|EC))", re.IGNORECASE)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("platform", choices=UPSTREAM_SHA256)
+    parser.add_argument("upstream", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--font", type=Path, required=True)
+    parser.add_argument("--font-license", type=Path, required=True)
+    parser.add_argument("--launcher", type=Path, required=True)
+    parser.add_argument("--launcher-arm64", type=Path)
+    args = parser.parse_args()
+
+    with args.upstream.open("rb") as upstream:
+        digest = hashlib.file_digest(upstream, "sha256").hexdigest()
+    if digest != UPSTREAM_SHA256[args.platform]:
+        parser.error("upstream v2.9.1 package failed SHA-256 verification")
+    if args.platform == "android":
+        if not args.launcher_arm64:
+            parser.error("--launcher-arm64 is required for Android")
+        replacements = {
+            "lib/armeabi-v7a/liblauncher.so": args.launcher,
+            "lib/arm64-v8a/liblauncher.so": args.launcher_arm64,
+        }
+    else:
+        replacements = {"ReKHCoM.exe": args.launcher}
+
+    with ZipFile(args.upstream) as source:
+        members = set(source.namelist())
+        if not replacements.keys() <= members:
+            parser.error("upstream package is missing expected launcher files")
+        if any(Path(name).suffix.lower() == ".gba" for name in members):
+            parser.error("ROM found in upstream package")
+        with ZipFile(args.output, "w", compression=ZIP_DEFLATED) as output:
+            for member in source.infolist():
+                name = member.filename
+                if args.platform == "android" and APK_SIGNATURE.fullmatch(name):
+                    continue
+                replacement = replacements.get(name)
+                output.writestr(member, replacement.read_bytes() if replacement else source.read(member))
+            output.write(args.font, "assets/fonts/ReKHCoM-Zh.ttf")
+            output.write(args.font_license, "assets/fonts/ReKHCoM-Zh-OFL.txt")
+
+
+if __name__ == "__main__":
+    main()
